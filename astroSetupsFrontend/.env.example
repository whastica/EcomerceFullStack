# ============================================================
# Variables de entorno del frontend (Astro Setups)
# Copiar este archivo como .env para desarrollo local.
# En Vercel se configuran en Settings > Environment Variables.
# ============================================================

# URL base de la API backend (OBLIGATORIA)
# Desarrollo local:  http://localhost:8081/api
# Produccion:        https://<tu-backend>.up.railway.app/api
VITE_API_BASE_URL=http://localhost:8081/api

# Nombre de la aplicacion (opcional)
VITE_APP_NAME=ASTROSETUPSFRONTEND
